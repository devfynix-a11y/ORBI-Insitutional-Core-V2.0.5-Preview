# ORBI Full Environment Template
# --------------------------------
# This file consolidates:
# - backend runtime variables
# - frontend/Vite variables
# - internal monitoring variables
# - script-only operational variables
#
# Do not commit real secrets into this file.

# Core Identity & Auth
APP_ID=
BACKEND_URL=
CLUSTER_ID=
NODE_ENV=development
ORBI_AUTH_PROVIDER=keycloak
ORBI_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.5.0
ORBI_KEYCLOAK_PUBLIC_URL=https://auth.orbifinancial.com
ORBI_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
ORBI_KEYCLOAK_ISSUER=https://auth.orbifinancial.com/realms/orbi
ORBI_KEYCLOAK_REALM=orbi
ORBI_KEYCLOAK_AUDIENCE=orbi-core
ORBI_KEYCLOAK_MOBILE_CLIENT_ID=orbi-mobile
ORBI_KEYCLOAK_ADMIN_USERNAME=orbi-admin
ORBI_KEYCLOAK_ADMIN_PASSWORD=
ORBI_KEYCLOAK_REQUIRE_CONFIRMATION=true
ORBI_DATA_PROVIDER=supabase
ORBI_LOCAL_DATA_PRODUCTION_READY=false
ORBI_AUTH_ISSUER=orbi-auth
ORBI_AUTH_AUDIENCE=orbi-core
DATABASE_URL=postgresql://orbi:change-me@localhost:5432/orbi
ORBI_IMAGE_STORAGE_PROVIDER=r2
ORBI_IMAGE_MAX_BYTES=5242880
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=orbi-images
CLOUDFLARE_PUBLIC_URL_PREFIX=https://media-stock.orbifinancial.com
PORT=3000
JWT_SECRET=
SESSION_SECRET=
WORKER_SECRET=
WORKER_SIGNING_SECRET=
KMS_MASTER_KEY=
KMS_MASTER_SALT=
KMS_SALT=

# AI & Intelligence
GEMINI_API_KEY=

# Database (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage (S3 / Supabase)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
KYC_BUCKET=

# ORBI Talk Gateway (SMS / email / push / templates)
ORBI_TALK_GATEWAY_URL=https://talk.orbifinancial.com
ORBI_TALK_GATEWAY_API_KEY=
ORBI_TALK_GATEWAY_USER_ID=
ORBI_TALK_GATEWAY_USER_EMAIL=
ORBI_PLATFORM_DISPLAY_NAME=ORBI Financial
ORBI_PLATFORM_SENDER_EMAIL=notifications@orbifinancial.com
ORBI_PLATFORM_REPLY_TO=support@orbifinancial.com
ORBI_PLATFORM_LOGO_URL=

# ORBI Payment Gateway / payment bridge
ORBI_GATEWAY_BASE_URL=https://gateway.orbifinancial.com

# Monitoring & Alerts
ORBI_MONITOR_API_KEY=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# Frontend (Vite)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STORAGE_PROVIDER=
VITE_AVATAR_BUCKET=

# Mobile / Client Identity
ORBI_ANDROID_APP_HASH=
ORBI_ANDROID_PACKAGE_NAME=com.orbi.mobile
ORBI_ANDROID_SMS_HASH=
ORBI_MOBILE_ORIGIN=ORBI_MOBILE_V2026
ORBI_MOBILE_APP_ID=mobile-android
ORBI_CORE_APP_ID=ORBI_NODE_APPS_V2026
ORBI_CORE_APP_ORIGIN=ORBI-NODE-APPS-V2026
ORBI_CORE_PORTAL_APP_ID=ORBI_NODE_PORTAL_V2026
ORBI_CORE_PORTAL_APP_ORIGIN=ORBI-NODE-PORTAL-V2026
ORBI_IOS_BUNDLE_IDS=com.orbi.mobile
ORBI_IOS_TEAM_ID=
RP_ID=api.orbifinancial.com
ORBI_WEB_ORIGIN=https://api.orbifinancial.com
ORIGIN=
ORBI_ALLOWED_ORIGINS=
ORBI_PRIMARY_CORE_BASE_URL=https://api.orbifinancial.com
ORBI_PRIMARY_CORE_REGION=private-datacenter
ORBI_PRIMARY_CORE_JURISDICTION=TZ

# Bootstrap / Admin Controls
ORBI_BOOTSTRAP_ADMIN_SECRET=
ORBI_REQUIRE_BOOTSTRAP_ADMIN_SECRET=true

# Redis / Cache / Queue
REDIS_URL=
REDIS_TLS_ENABLED=false
REDIS_ALLOW_INSECURE_TLS=false
REDIS_CA_CERT_PATH=

# Transport / TLS
ORBI_ENFORCE_HTTPS=true
ORBI_TLS_ENABLED=false
ORBI_TLS_CERT_PATH=
ORBI_TLS_KEY_PATH=
ORBI_TLS_CA_PATH=
ORBI_TLS_REJECT_UNAUTHORIZED=true

# Internal mTLS / Worker Trust
ORBI_INTERNAL_MTLS_MODE=required
ORBI_INTERNAL_MTLS_SOURCE=proxy
ORBI_INTERNAL_MTLS_PROXY_HEADER=x-orbi-mtls-attested
ORBI_INTERNAL_MTLS_PROXY_SHARED_SECRET=
ORBI_INTERNAL_MTLS_CA_PATH=

# Feature Flags / Operational Safety
ORBI_ENABLE_GATEWAY_BACKGROUND_JOBS=true
ORBI_ENABLE_INTERNAL_BACKGROUND_JOBS=false
ORBI_ALLOW_PROCESS_LOCAL_IDEMPOTENCY=false
ORBI_ENABLE_LEGACY_API_GATEWAY=false
ORBI_ENABLE_LEGACY_BIOMETRIC_ROUTES=false
ORBI_ALLOW_LOCAL_SESSION_FALLBACK=false
ORBI_ENABLE_SANDBOX_ROUTES=false
ORBI_ENABLE_MESSAGING_TEST_ROUTES=false
ORBI_REQUIRE_WEBHOOK_SIGNATURES=true
ORBI_PROVIDER_TIMEOUT_MS=15000
ORBI_PROVIDER_MAX_ATTEMPTS=
ORBI_PROVIDER_RETRY_DELAY_MS=
ORBI_WEBHOOK_MAX_AGE_SECONDS=
ORBI_WEBHOOK_REPLAY_WINDOW_SECONDS=3600
ORBI_ALLOW_INSECURE_PROVIDER_URLS=false
ORBI_ALLOW_PROCESS_LOCAL_WEBHOOK_REPLAY_STORE=false
ORBI_VALIDATE_DB_ON_STARTUP=
ORBI_VALIDATE_RPC_ON_STARTUP=
ORBI_STARTUP_DB_TIMEOUT_MS=

# Firebase (Legacy/Broker)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Review / Legacy / Team-Specific
NEW_SECRET=

# ------------------------------------------------------------
# Script-Only Variables
# These are not required for normal backend startup.
# Use them for smoke tests, load tests, and DR drill reporting.
# ------------------------------------------------------------

# Release Smoke / Manual Ops Checks
ORBI_BASE_URL=
ORBI_EXPECT_BROKER_HEALTH=false

# Load Testing
ORBI_VUS=20
ORBI_TEST_DURATION=2m

# Disaster Recovery Drill Report
ORBI_DRILL_TYPE=
ORBI_DRILL_ENV=
ORBI_DRILL_OWNER=
ORBI_DRILL_REVIEWER=
ORBI_DRILL_STATUS=
ORBI_DRILL_SUMMARY=
ORBI_DRILL_BACKUP_ID=
ORBI_DRILL_BACKUP_TIMESTAMP=
ORBI_DRILL_RESTORE_STARTED_AT=
ORBI_DRILL_RESTORE_COMPLETED_AT=
ORBI_DRILL_RECOVERY_TARGET_AT=
ORBI_DRILL_NOTES=
ORBI_DRILL_ACTION_ITEMS=
