COMPOSE_PROJECT_NAME=orbi
ORBI_RELEASE_ID=local

# ============================================================
# ORBI production secret file template
# Copy to ops/self-hosted/.env.production or /etc/orbi/core.env.
# Never commit the copied file. Empty values below are required secrets
# that must be generated or supplied by an authorized operator.
# ============================================================

NODE_ENV=production
PORT=3000
BACKEND_URL=https://api.orbifinancial.com
ORBI_AUTH_PROVIDER=keycloak
ORBI_DATA_PROVIDER=supabase
ORBI_LOCAL_DATA_PRODUCTION_READY=false

JWT_SECRET=
SESSION_SECRET=
KMS_MASTER_KEY=
KMS_SALT=
ORBI_SECRET_ENCRYPTION_KEY=
WORKER_SECRET=
WORKER_SIGNING_SECRET=
ORBI_MONITOR_API_KEY=
ORBI_BOOTSTRAP_ADMIN_SECRET=
ORBI_INTERNAL_MTLS_MODE=required
ORBI_INTERNAL_MTLS_SOURCE=proxy
ORBI_INTERNAL_MTLS_PROXY_SHARED_SECRET=

ORBI_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.5.0
ORBI_KEYCLOAK_PUBLIC_URL=https://auth.orbifinancial.com
ORBI_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
ORBI_KEYCLOAK_ISSUER=https://auth.orbifinancial.com/realms/orbi
ORBI_KEYCLOAK_REALM=orbi
ORBI_KEYCLOAK_AUDIENCE=orbi-core
ORBI_KEYCLOAK_MOBILE_CLIENT_ID=orbi-mobile
ORBI_KEYCLOAK_ADMIN_USERNAME=orbi-admin
ORBI_KEYCLOAK_ADMIN_PASSWORD=
ORBI_KEYCLOAK_REQUIRE_CONFIRMATION=true

ORBI_POSTGRES_IMAGE=postgres:16-bookworm
ORBI_POSTGRES_DB=orbi
ORBI_POSTGRES_USER=orbi
ORBI_POSTGRES_PASSWORD=
DATABASE_URL=
ORBI_DATABASE_POOL_MAX=40
ORBI_DATABASE_CONNECT_TIMEOUT_MS=5000
ORBI_DATABASE_IDLE_TIMEOUT_MS=30000
ORBI_DATABASE_SSL=false

ORBI_VALKEY_IMAGE=valkey/valkey:8.0-bookworm
ORBI_VALKEY_PASSWORD=
VALKEY_URL=
VALKEY_TLS_ENABLED=false
VALKEY_ALLOW_INSECURE_TLS=false

ORBI_STORAGE_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
ORBI_STORAGE_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
ORBI_STORAGE_ROOT_USER=orbi-storage
ORBI_STORAGE_ROOT_PASSWORD=
ORBI_STORAGE_ASSET_BUCKET=orbi-assets
ORBI_STORAGE_KYC_BUCKET=orbi-kyc
ORBI_STORAGE_BACKUP_BUCKET=orbi-backups

ORBI_IMAGE_STORAGE_PROVIDER=r2
ORBI_IMAGE_MAX_BYTES=5242880
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=orbishop-storage
CLOUDFLARE_PUBLIC_URL_PREFIX=https://media-stock.orbifinancial.com
# Legacy aliases remain supported by the image storage adapter. Keep them
# populated with the same R2 credentials while older services are migrating.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_IMAGE_BUCKET=orbishop-storage
ORBI_IMAGE_PUBLIC_BASE_URL=https://media-stock.orbifinancial.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ORBI_TALK_GATEWAY_URL=https://talk.orbifinancial.com
ORBI_TALK_GATEWAY_API_KEY=
ORBI_TALK_GATEWAY_USER_ID=
ORBI_TALK_GATEWAY_USER_EMAIL=
ORBI_PLATFORM_DISPLAY_NAME=ORBI Financial
ORBI_PLATFORM_SENDER_EMAIL=notifications@orbifinancial.com
ORBI_PLATFORM_REPLY_TO=support@orbifinancial.com
ORBI_PLATFORM_LOGO_URL=
ORBI_PAY_GATEWAY_BASE_URL=https://pay.orbifinancial.com
ORBI_PAY_GATEWAY_OPERATOR_DISCOVERY_API_KEY=
ORBI_PAY_GATEWAY_SERVICE_PAYMENT_EVENT_PATH=/v1/internal/core/service-payment-events
ORBI_CORE_PAY_GATEWAY_WORKER_ID=orbi-core

ORBI_ANDROID_APP_HASH=
ORBI_ANDROID_SMS_HASH=
ORBI_ANDROID_PACKAGE_NAME=com.orbi.mobile
ORBI_MOBILE_ORIGIN=ORBI_MOBILE_V2026
ORBI_MOBILE_APP_ID=mobile-android
ORBI_CORE_PORTAL_APP_ID=ORBI_NODE_PORTAL_V2026
ORBI_CORE_PORTAL_APP_ORIGIN=ORBI-NODE-PORTAL-V2026
RP_ID=api.orbifinancial.com
ORBI_WEB_ORIGIN=https://api.orbifinancial.com
ORBI_ALLOWED_ORIGINS=https://api.orbifinancial.com,https://auth.orbifinancial.com,https://ops.orbifinancial.com
ORBI_PRIMARY_CORE_BASE_URL=https://api.orbifinancial.com
ORBI_PRIMARY_CORE_REGION=private-datacenter
ORBI_PRIMARY_CORE_JURISDICTION=TZ
ORBI_PRIMARY_CORE_LAT=-6.7924
ORBI_PRIMARY_CORE_LNG=39.2083

ORBI_ENFORCE_HTTPS=true
ORBI_TLS_ENABLED=false
ORBI_REQUIRE_SIGNED_INTERNAL_REQUESTS=true
ORBI_ALLOW_LEGACY_INTERNAL_WORKER_AUTH=false
ORBI_ALLOW_PROCESS_LOCAL_IDEMPOTENCY=false
ORBI_API_GATEWAY_ENABLED=true
ORBI_API_GATEWAY_FAIL_CLOSED=true
ORBI_API_GATEWAY_REDIS_REQUIRED=true
ORBI_REQUIRE_WEBHOOK_SIGNATURES=true
ORBI_ENABLE_GATEWAY_BACKGROUND_JOBS=false
ORBI_ENABLE_INTERNAL_BACKGROUND_JOBS=false
ORBI_ALLOW_LOCAL_SESSION_FALLBACK=false
ORBI_ENABLE_SANDBOX_ROUTES=false
ORBI_ENABLE_MESSAGING_TEST_ROUTES=false
ORBI_REQUIRE_BOOTSTRAP_ADMIN_SECRET=true
ORBI_REQUIRE_ADMIN_TRACE=true
ORBI_REQUIRE_ADMIN_DEVICE_ID=false
ORBI_PROVIDER_TIMEOUT_MS=15000

ORBI_TLS_CERT_DIRECTORY=/srv/orbi/secrets/tls
ORBI_MONITOR_KEY_FILE=/srv/orbi/secrets/orbi_monitor_api_key.txt
ORBI_GRAFANA_ADMIN_USER=orbi-admin
ORBI_GRAFANA_ADMIN_PASSWORD=
ORBI_GRAFANA_DOMAIN=localhost
ORBI_PROMETHEUS_RETENTION=30d
ORBI_OPS_REQUIRED_APPROVALS=2
ORBI_OPS_AGENT_EXECUTION_ENABLED=false
ORBI_OPS_DESTRUCTIVE_ACTIONS_ENABLED=false
ORBI_OPS_AGENT_DATABASE_URL=
ORBI_OPS_AGENT_ROOT=/opt/orbi/core
ORBI_OPS_AGENT_ID=orbi-vm-agent-primary
ORBI_OPS_AGENT_POLL_MS=15000
ORBI_OPS_AGENT_COMMAND_TIMEOUT_MS=1200000
ORBI_BACKUP_INTERVAL_SECONDS=86400
ORBI_BACKUP_RETENTION_DAYS=14
ORBI_BACKUP_LOCAL_DIR=/srv/orbi/backups/database
ORBI_BACKUP_ENCRYPTION_KEY=
ORBI_BACKUP_R2_BUCKET=orbishop-storage
ORBI_BACKUP_R2_PREFIX=database-backups
ORBI_BACKUP_R2_SYNC_INTERVAL_SECONDS=300

FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
GEMINI_API_KEY=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

ADMIN_VPN_CIDR=
